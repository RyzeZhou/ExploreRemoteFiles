<Window x:Class="RemoteFsClient.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="580" Width="860" MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：导航。功能会越加越多，设置按"一页一栏"放，别再挤在一屏里。 -->
        <ListBox x:Name="NavList" SelectionChanged="OnNavChanged" BorderThickness="1"
                 Background="#F7F7F7" Padding="4,8">
            <ListBoxItem x:Name="NavGeneral" Padding="10,7"/>
            <ListBoxItem x:Name="NavCaches" Padding="10,7"/>
            <ListBoxItem x:Name="NavDownload" Padding="10,7"/>
            <ListBoxItem x:Name="NavAssoc" Padding="10,7"/>
        </ListBox>

        <!-- 右：具体设置 -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 通用 -->
            <Grid x:Name="SectionGeneral">
                <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ExplorerLanguageLabel" VerticalAlignment="Center"/>
                <ComboBox x:Name="ExplorerLanguageBox" Grid.Column="1" Margin="0,4" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem><ComboBoxItem Tag="en-US">English</ComboBoxItem>
                </ComboBox>
                <TextBlock x:Name="ServiceLanguageLabel" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <ComboBox x:Name="ServiceLanguageBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,4" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem><ComboBoxItem Tag="en-US">English</ComboBoxItem>
                </ComboBox>
                <TextBlock x:Name="DefaultViewLabel" Grid.Row="2" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <ComboBox x:Name="DefaultViewBox" Grid.Row="2" Grid.Column="1" Margin="0,12,0,4" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="icons"/><ComboBoxItem Tag="list"/><ComboBoxItem Tag="details"/>
                    <ComboBoxItem Tag="tiles"/><ComboBoxItem Tag="content"/>
                </ComboBox>
                <TextBlock x:Name="SizeFormatLabel" Grid.Row="3" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <ComboBox x:Name="SizeFormatBox" Grid.Row="3" Grid.Column="1" Margin="0,12,0,4" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="auto"/><ComboBoxItem Tag="kb"/><ComboBoxItem Tag="si"/><ComboBoxItem Tag="iec"/>
                </ComboBox>
                <TextBlock x:Name="TerminalLabel" Grid.Row="4" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <ComboBox x:Name="TerminalBox" Grid.Row="4" Grid.Column="1" Margin="0,12,0,4" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="wt"/><ComboBoxItem Tag="powershell"/><ComboBoxItem Tag="vscode"/>
                </ComboBox>
                <TextBlock x:Name="GeneralHintText" Grid.Row="5" Grid.ColumnSpan="2" TextWrapping="Wrap"
                           Foreground="#666" Margin="0,18,0,0" VerticalAlignment="Top"/>
            </Grid>

            <!-- 缓存与编辑器 -->
            <Grid x:Name="SectionCaches" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="WinScpPathLabel" VerticalAlignment="Center"/>
                <TextBox x:Name="WinScpPathBox" Grid.Column="1" Margin="0,4,8,0"/>
                <Button x:Name="BrowseButton" Grid.Column="2" Click="OnBrowse" Padding="12,4" Margin="0,4,0,0"/>
                <TextBlock x:Name="MetadataCachePathLabel" Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="MetadataCachePathBox" Grid.Row="1" Grid.Column="1" Margin="0,14,8,0"/>
                <Button x:Name="BrowseMetadataCacheButton" Grid.Row="1" Grid.Column="2" Click="OnBrowseMetadataCache" Padding="12,4" Margin="0,14,0,0"/>
                <TextBlock x:Name="FileCachePathLabel" Grid.Row="2" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="FileCachePathBox" Grid.Row="2" Grid.Column="1" Margin="0,14,8,0"/>
                <Button x:Name="BrowseFileCacheButton" Grid.Row="2" Grid.Column="2" Click="OnBrowseFileCache" Padding="12,4" Margin="0,14,0,0"/>
                <TextBlock x:Name="DefaultEditorLabel" Grid.Row="3" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="EditorPathBox" Grid.Row="3" Grid.Column="1" Margin="0,14,8,0"/>
                <Button x:Name="BrowseEditorButton" Grid.Row="3" Grid.Column="2" Click="OnBrowseEditor" Padding="12,4" Margin="0,14,0,0"/>
                <TextBlock x:Name="DirCacheTtlLabel" Grid.Row="4" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="DirCacheTtlBox" Grid.Row="4" Grid.Column="1" Margin="0,14,8,0"/>
                <TextBlock x:Name="DirCacheDiskLabel" Grid.Row="5" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="DirCacheDiskBox" Grid.Row="5" Grid.Column="1" Margin="0,14,8,0"/>
                <TextBlock x:Name="DirCacheRevalidateLabel" Grid.Row="6" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="DirCacheRevalidateBox" Grid.Row="6" Grid.Column="1" Margin="0,14,8,0"/>
                <CheckBox x:Name="MruCheck" Grid.Row="7" Grid.ColumnSpan="3" Margin="0,14,0,0"/>
                <TextBlock x:Name="MruIntervalLabel" Grid.Row="8" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="MruIntervalBox" Grid.Row="8" Grid.Column="1" Margin="0,14,8,0"/>
                <TextBlock x:Name="MruMaxLabel" Grid.Row="9" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="MruMaxBox" Grid.Row="9" Grid.Column="1" Margin="0,14,8,0"/>
                <TextBlock x:Name="CachesHintText" Grid.Row="10" Grid.ColumnSpan="3" TextWrapping="Wrap"
                           Foreground="#666" Margin="0,18,0,0" VerticalAlignment="Top"/>
            </Grid>

            <!-- 下载 -->
            <Grid x:Name="SectionDownload" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DownloadDirLabel" VerticalAlignment="Center"/>
                <TextBox x:Name="DownloadDirBox" Grid.Column="1" Margin="0,4,8,0"/>
                <Button x:Name="BrowseDownloadDirButton" Grid.Column="2" Click="OnBrowseDownloadDir" Padding="12,4" Margin="0,4,0,0"/>
                <CheckBox x:Name="TicketModeCheck" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0"/>
                <TextBlock x:Name="DownloadHintText" Grid.Row="2" Grid.ColumnSpan="3" TextWrapping="Wrap"
                           Foreground="#666" Margin="0,14,0,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="TicketModeHint" Grid.Row="3" Grid.ColumnSpan="3" TextWrapping="Wrap"
                           Foreground="#666" Margin="0,6,0,0" VerticalAlignment="Top"/>
            </Grid>

            <!-- 文件关联 -->
            <StackPanel x:Name="SectionAssoc" Visibility="Collapsed">
                <TextBlock x:Name="AssocHintText" TextWrapping="Wrap" Foreground="#666"/>
                <TextBlock x:Name="AssocStatusText" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <Button x:Name="AssocReassocButton" Click="OnReassociate" Padding="14,5"
                        HorizontalAlignment="Left" Margin="0,14,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="SaveButton" Click="OnSave" Padding="16,4" Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" IsCancel="True" Padding="16,4"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
