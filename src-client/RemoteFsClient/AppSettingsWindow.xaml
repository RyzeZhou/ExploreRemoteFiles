<Window x:Class="RemoteFsClient.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="536" Width="650" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <TextBlock x:Name="WinScpPathLabel" VerticalAlignment="Center"/>
        <TextBox x:Name="WinScpPathBox" Grid.Column="1" Margin="0,0,8,0"/>
        <Button x:Name="BrowseButton" Grid.Column="2" Click="OnBrowse" Padding="12,4"/>

        <TextBlock x:Name="MetadataCachePathLabel" Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,0"/>
        <TextBox x:Name="MetadataCachePathBox" Grid.Row="1" Grid.Column="1" Margin="0,14,8,0"/>
        <Button x:Name="BrowseMetadataCacheButton" Grid.Row="1" Grid.Column="2" Click="OnBrowseMetadataCache" Padding="12,4" Margin="0,14,0,0"/>

        <TextBlock x:Name="FileCachePathLabel" Grid.Row="2" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <TextBox x:Name="FileCachePathBox" Grid.Row="2" Grid.Column="1" Margin="0,10,8,0"/>
        <Button x:Name="BrowseFileCacheButton" Grid.Row="2" Grid.Column="2" Click="OnBrowseFileCache" Padding="12,4" Margin="0,10,0,0"/>

        <TextBlock x:Name="DefaultEditorLabel" Grid.Row="3" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <TextBox x:Name="EditorPathBox" Grid.Row="3" Grid.Column="1" Margin="0,10,8,0"/>
        <Button x:Name="BrowseEditorButton" Grid.Row="3" Grid.Column="2" Click="OnBrowseEditor" Padding="12,4" Margin="0,10,0,0"/>

        <TextBlock x:Name="ExplorerLanguageLabel" Grid.Row="4" VerticalAlignment="Center" Margin="0,14,0,0"/>
        <ComboBox x:Name="ExplorerLanguageBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0" SelectedValuePath="Tag">
            <ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem><ComboBoxItem Tag="en-US">English</ComboBoxItem>
        </ComboBox>
        <TextBlock x:Name="ServiceLanguageLabel" Grid.Row="5" VerticalAlignment="Center" Margin="0,10,0,0"/>
        <ComboBox x:Name="ServiceLanguageBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" SelectedValuePath="Tag">
            <ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem><ComboBoxItem Tag="en-US">English</ComboBoxItem>
        </ComboBox>
        <TextBlock x:Name="DefaultViewLabel" Grid.Row="6" VerticalAlignment="Center" Margin="0,14,0,0"/>
        <ComboBox x:Name="DefaultViewBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0" SelectedValuePath="Tag">
            <ComboBoxItem Tag="icons"/><ComboBoxItem Tag="list"/><ComboBoxItem Tag="details"/><ComboBoxItem Tag="tiles"/><ComboBoxItem Tag="content"/>
        </ComboBox>
        <TextBlock x:Name="SizeFormatLabel" Grid.Row="7" VerticalAlignment="Center" Margin="0,14,0,0"/>
        <ComboBox x:Name="SizeFormatBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0" SelectedValuePath="Tag">
            <ComboBoxItem Tag="auto"/><ComboBoxItem Tag="kb"/><ComboBoxItem Tag="si"/><ComboBoxItem Tag="iec"/>
        </ComboBox>
        <TextBlock x:Name="TerminalLabel" Grid.Row="8" VerticalAlignment="Center" Margin="0,14,0,0"/>
        <ComboBox x:Name="TerminalBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,14,0,0" SelectedValuePath="Tag">
            <ComboBoxItem Tag="wt"/><ComboBoxItem Tag="powershell"/><ComboBoxItem Tag="vscode"/>
        </ComboBox>
        <TextBlock x:Name="HintText" Grid.Row="9" Grid.ColumnSpan="3" TextWrapping="Wrap" Foreground="#666" Margin="0,16,0,0"/>
        <StackPanel Grid.Row="10" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Click="OnSave" Padding="16,4" Margin="0,0,8,0"/><Button x:Name="CancelButton" IsCancel="True" Padding="16,4"/>
        </StackPanel>
    </Grid>
</Window>
