<Window x:Class="RemoteFsClient.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程传输" Height="330" Width="760"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView x:Name="TaskList" Grid.Row="0" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="方向" Width="70" DisplayMemberBinding="{Binding DirectionLabel}"/>
                    <GridViewColumn Header="文件" Width="200" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="进度" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="已传输" Width="130" DisplayMemberBinding="{Binding ProgressText}"/>
                    <GridViewColumn Header="速度" Width="90" DisplayMemberBinding="{Binding SpeedText}"/>
                    <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding StatusText}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ClearButton" Content="清除已完成" Padding="12,4" Margin="0,0,8,0"/>
            <Button x:Name="CloseButton" Content="关闭" Padding="12,4"/>
        </StackPanel>
    </Grid>
</Window>
