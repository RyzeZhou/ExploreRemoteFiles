<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableComHosting>true</EnableComHosting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ExplorerRemoteFs</AssemblyName>
    <RootNamespace>ExplorerRemoteFs</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- comhost 加载托管程序集需要相邻的 .runtimeconfig.json 定位运行时 -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="8.0.10" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="FluentFTP" Version="53.0.2" />
  </ItemGroup>

</Project>
