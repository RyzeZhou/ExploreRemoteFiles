docs/

# 安装器自测产物（日志留本地看，不进仓库）
src-setup/*.log*
research/

# 工作临时目录：远程仓库备份、调试草稿、换 DLL 时的 .bak，以及被别的项目测试副本塞进来的
# 内容（node_modules / 数据集等）。一律不进仓库 —— 2026-09-27 它没被忽略时，
# `git add -A` 直接被这堆文件卡死（还有超长路径警告刷屏）。
tmp/
