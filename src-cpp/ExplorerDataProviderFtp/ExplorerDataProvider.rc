IDD_NAMEBOX DIALOGEX 0, 0, 224, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name:", IDC_STATIC, 8, 10, 40, 10
    EDITTEXT        3101, 52, 8, 164, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 62, 38, 48, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 118, 38, 48, 14
END

IDD_PERMBOX DIALOGEX 0, 0, 240, 268
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Remote Permissions"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name:", IDC_STATIC, 12, 12, 44, 10
    LTEXT           "", 3001, 60, 12, 170, 10
    LTEXT           "Type:", IDC_STATIC, 12, 28, 44, 10
    LTEXT           "", 3002, 60, 28, 170, 10
    LTEXT           "Permissions:", IDC_STATIC, 12, 44, 60, 10
    LTEXT           "", 3003, 80, 44, 150, 10
    LTEXT           "Owner:", IDC_STATIC, 12, 60, 44, 10
    LTEXT           "", 3004, 60, 60, 170, 10
    LTEXT           "Group:", IDC_STATIC, 12, 76, 44, 10
    LTEXT           "", 3005, 60, 76, 170, 10
    LTEXT           "Size:", IDC_STATIC, 12, 92, 44, 10
    LTEXT           "", 3006, 60, 92, 170, 10
    LTEXT           "Modified:", IDC_STATIC, 12, 108, 48, 10
    LTEXT           "", 3007, 64, 108, 166, 10
    LTEXT           "New owner (UID):", IDC_STATIC, 12, 124, 72, 10
    EDITTEXT        3024, 88, 122, 142, 14, ES_AUTOHSCROLL
    LTEXT           "New group (GID):", IDC_STATIC, 12, 140, 72, 10
    EDITTEXT        3025, 88, 138, 142, 14, ES_AUTOHSCROLL
    GROUPBOX        "Permissions", IDC_STATIC, 12, 158, 218, 56
    LTEXT           "Owner", IDC_STATIC, 22, 172, 40, 10
    AUTOCHECKBOX    "Read", 3011, 72, 172, 42, 10
    AUTOCHECKBOX    "Write", 3012, 118, 172, 42, 10
    AUTOCHECKBOX    "Exec", 3013, 164, 172, 42, 10
    LTEXT           "Group", IDC_STATIC, 22, 188, 40, 10
    AUTOCHECKBOX    "Read", 3014, 72, 188, 42, 10
    AUTOCHECKBOX    "Write", 3015, 118, 188, 42, 10
    AUTOCHECKBOX    "Exec", 3016, 164, 188, 42, 10
    LTEXT           "Others", IDC_STATIC, 22, 204, 40, 10
    AUTOCHECKBOX    "Read", 3017, 72, 204, 42, 10
    AUTOCHECKBOX    "Write", 3018, 118, 204, 42, 10
    AUTOCHECKBOX    "Exec", 3019, 164, 204, 42, 10
    LTEXT           "Octal:", IDC_STATIC, 12, 223, 36, 10
    EDITTEXT        3022, 52, 221, 44, 14, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Recursive (subdirs)", 3023, 108, 222, 122, 10
    DEFPUSHBUTTON   "OK", IDOK, 82, 244, 56, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 146, 244, 56, 14
END

// Property-sheet version of the permissions page (no buttons; the standard
// Properties dialog provides OK/Cancel). Standard property-page template
// style: DS_FIXEDSYS | WS_CHILD | WS_DISABLED.
