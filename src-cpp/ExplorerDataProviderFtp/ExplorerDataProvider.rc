// Read-only connection info page for a saved site (site-picker level 0).
IDD_SITEPAGE DIALOGEX 0, 0, 220, 112
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Connection"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Name:", 4011, 8, 8, 48, 10
    LTEXT           "", 4001, 62, 8, 150, 10
    LTEXT           "Host:", 4012, 8, 24, 48, 10
    LTEXT           "", 4002, 62, 24, 150, 10
    LTEXT           "Protocol:", 4013, 8, 40, 48, 10
    LTEXT           "", 4003, 62, 40, 150, 10
    LTEXT           "Port:", 4014, 8, 56, 48, 10
    LTEXT           "", 4004, 62, 56, 150, 10
    LTEXT           "User:", 4015, 8, 72, 48, 10
    LTEXT           "", 4005, 62, 72, 150, 10
    LTEXT           "Start path:", 4016, 8, 88, 48, 10
    LTEXT           "", 4006, 62, 88, 150, 10
END
// Non-modal view used by the background-menu "Current site information" command.
// Its fields deliberately match IDD_SITEPAGE, which is the site root Properties page.
IDD_SITEBOX DIALOGEX 0, 0, 220, 130
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connection"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Name:", 4011, 8, 8, 48, 10
    LTEXT           "", 4001, 62, 8, 150, 10
    LTEXT           "Host:", 4012, 8, 24, 48, 10
    LTEXT           "", 4002, 62, 24, 150, 10
    LTEXT           "Protocol:", 4013, 8, 40, 48, 10
    LTEXT           "", 4003, 62, 40, 150, 10
    LTEXT           "Port:", 4014, 8, 56, 48, 10
    LTEXT           "", 4004, 62, 56, 150, 10
    LTEXT           "User:", 4015, 8, 72, 48, 10
    LTEXT           "", 4005, 62, 72, 150, 10
    LTEXT           "Start path:", 4016, 8, 88, 48, 10
    LTEXT           "", 4006, 62, 88, 150, 10
    DEFPUSHBUTTON   "Close", IDCANCEL, 164, 108, 48, 14
END
// Copy target picker. It distinguishes the source remote path from the target kind
// so the same verb can grow from local duplication into cross-site and local copies.
IDD_COPYBOX DIALOGEX 0, 0, 312, 196
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Copy to"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Source remote path:", 4101, 12, 12, 82, 10
    EDITTEXT        4102, 12, 25, 288, 14, ES_AUTOHSCROLL | ES_READONLY
    GROUPBOX        "Destination", 4112, 12, 47, 288, 112
    AUTORADIOBUTTON "Create a copy in the original folder", 4103, 22, 61, 266, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Same site", 4104, 22, 79, 80, 10
    AUTORADIOBUTTON "Other site", 4105, 22, 97, 80, 10
    AUTORADIOBUTTON "Local folder", 4106, 22, 115, 80, 10
    LTEXT           "Target site:", 4107, 104, 97, 58, 10
    COMBOBOX        4108, 164, 95, 124, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Target path:", 4109, 104, 117, 58, 10
    EDITTEXT        4110, 164, 115, 94, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", 4111, 262, 115, 26, 14
    DEFPUSHBUTTON   "OK", IDOK, 188, 170, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 248, 170, 52, 14
END
